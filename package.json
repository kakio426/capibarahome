{
  "name": "capybara-butler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "export:assets": "node scripts/exportPlatformAssets.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "device:qa:devices": "node scripts/androidDeviceQa.mjs devices",
    "device:qa:install": "node scripts/androidDeviceQa.mjs install",
    "device:qa:launch": "node scripts/androidDeviceQa.mjs launch",
    "device:qa:info": "node scripts/androidDeviceQa.mjs info",
    "device:qa:capture": "node scripts/androidDeviceQa.mjs capture",
    "device:qa:record": "node scripts/androidDeviceQa.mjs record"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.52.0",
    "vitest": "^3.0.0"
  }
}
